# Copy to `.env` and edit. `.env` is git-ignored.
#
# This is the ONLY configuration the app reads. EXPO_PUBLIC_* values are compiled into the
# JavaScript bundle and are visible to anyone with the app, so never put a secret here.
#
# Where is the backend, from the app's point of view?
#   Android emulator          http://10.0.2.2:4000      (this is also the default when unset)
#   Physical phone, same Wi-Fi http://<your-computer-LAN-IP>:4000   e.g. http://192.168.1.23:4000
#   Physical phone over USB   http://localhost:4000     after running: adb reverse tcp:4000 tcp:4000
#   iOS simulator             http://localhost:4000
#
# Inside the Android emulator, "localhost" is the emulator itself, NOT your computer.
# 10.0.2.2 is the emulator's alias for the computer it runs on.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
