# Copy to `.env` and edit. `.env` is git-ignored. Never commit real secrets.

NODE_ENV=development
PORT=4000
# 0.0.0.0 lets the Android emulator (10.0.2.2) and a physical phone on your Wi-Fi reach the API.
# Use 127.0.0.1 if you only want local access.
HOST=0.0.0.0
LOG_LEVEL=info

# Local development database (matches docker-compose.yml). Local-only credential.
DATABASE_URL=postgres://miniledger:miniledger_local@localhost:5432/miniledger_dev

# Used ONLY when NODE_ENV=test (npm test). The database name must end in `_test`,
# the host must be loopback, and it must differ from DATABASE_URL, or tests refuse to run.
TEST_DATABASE_URL=postgres://miniledger:miniledger_local@localhost:5432/miniledger_test

# Secrets: each must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start while these still hold the REPLACE_ME placeholders.
JWT_SECRET=REPLACE_ME_with_output_of_the_node_command_above
OTP_HMAC_SECRET=REPLACE_ME_with_a_different_output_of_the_node_command

# Auth tuning (defaults shown)
JWT_TTL_SECONDS=604800
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# IANA timezone that defines "today" for overdue calculations.
APP_TIMEZONE=Asia/Kolkata

# Comma-separated browser origins allowed by CORS (native apps send no Origin header).
CORS_ORIGINS=http://localhost:8081
