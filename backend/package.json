{
  "name": "miniledger-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MiniLedger API: mock-OTP login, loans, repayment and summary on PostgreSQL.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "setup:env": "node scripts/setup-env.mjs",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations --envPath .env",
    "migrate:down": "node-pg-migrate down 1 --migrations-dir migrations --envPath .env",
    "migrate:test:up": "node-pg-migrate up --migrations-dir migrations --envPath .env --database-url-var TEST_DATABASE_URL"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.0",
    "pino": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
